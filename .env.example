# ============================================================
# predict.fun AI trading bot — configuration
# Copy to .env and fill in ON THE VPS ONLY.
# NEVER commit the real .env, screenshot it, or paste keys into GitHub/chat.
# ============================================================

# --- 1. predict.fun API (request via Discord ticket: discord.gg/predictdotfun)
PREDICT_API_KEY=
# mainnet (real money) or testnet (free, no API key needed)
PREDICT_ENV=mainnet

# --- 2. LLM brain
# vikey (DeepSeek) | glm (Vikey GLM) | gemini | auto
# auto = uji satu otak sampai EVAL_TRADES_PER_MODEL (atau circuit breaker),
# lalu pindah sendiri. Urutan: LLM_ROTATION. Setelah Gemini selesai, balik
# ke DeepSeek (tidak reset tengah malam).
LLM_PROVIDER=auto
LLM_ROTATION=vikey,glm,gemini
EVAL_TRADES_PER_MODEL=10
VIKEY_API_KEY=
VIKEY_MODEL=deepseek/deepseek-v4-flash
GLM_MODEL=glm/glm-5.3-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- 3. Wallet
# Export the Privy wallet private key from predict.fun > Account > Settings
PRIVY_WALLET_PRIVATE_KEY=
# Your predict.fun deposit address (smart wallet). Leave empty for a plain EOA.
PREDICT_ACCOUNT_ADDRESS=
# BSC RPC (optional). If this host 524s/times out, the bot tries official
# dataseed + other public endpoints. Comma-separated extras:
# BSC_RPC_FALLBACKS=https://bsc-dataseed.binance.org,https://binance.llamarpc.com
BSC_RPC_URL=

# --- Telegram notifications (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Market selection
# ============================================================
# CRYPTO_UP_DOWN = only Crypto Up-or-Down rounds (BTC/ETH/BNB vs a strike
# price, resolved by the Binance feed). Use ALL to trade every market type.
MARKET_VARIANT=CRYPTO_UP_DOWN
# Skip a round when it has less than this many seconds left
MIN_TIME_LEFT_SEC=180

# ============================================================
# Indicator filters (EMA / RSI / MACD / volume / spread / book)
# All computed from public Binance candles + depth — no extra API key.
# ============================================================
# Need this many of EMA, RSI, MACD, order-book imbalance pointing the same way
MIN_INDICATOR_AGREE=3
# Skip when Binance bid-ask is wider than this (basis points). Stops the bot
# treating a fat spread as a real price move.
MAX_SPREAD_BPS=12
# Skip when predict.fun UP ask + DOWN ask - 1 is wider than this
MAX_MARKET_SPREAD=0.06
# Last 1m volume vs the prior 20-minute average (1.0 = average)
MIN_VOLUME_RATIO=0.8
# Skip a 1m range spike this many times the typical range
MAX_ATR_MULT=3.5
# Spreadsheet MTF gates (5m trigger + 15m/60m context). MTF_GATE=off = old 1m 3/4 vote.
MTF_GATE=off
ADX_MIN=20
ATR_PCT_5M_MIN=0.04
ATR_PCT_5M_MAX=1.2
MIN_VOLUME_RATIO_BNB=1.0

# ============================================================
# ML ensemble filter (XGBoost, LightGBM, Random Forest, Logistic)
# Trained locally from public Binance candles — no extra API key.
# Off until you run: npm run ml:train
# ============================================================
ML_FILTER=on
# How many of the 4 models must agree with the indicator lead
MIN_ML_AGREE=2
# A model only votes if P(Up) is at least this far from a coin flip
ML_MIN_PROBA=0.55
# Optional: full path to the venv python (default: .venv/bin/python3)
ML_PYTHON=

# ============================================================
# Strategy / money management
# ============================================================
# on (default) = size from the live predict.fun USDT balance every scan,
# so wins compound and losses shrink the next ticket.
# off = always use BANKROLL_USD (fixed, no compounding).
BANKROLL_LIVE=on
# Fallback only, used when live fetch fails or BANKROLL_LIVE=off
BANKROLL_USD=100
# Standard 1x entry: max(this floor, BASE_STAKE_PCT % of live USDT)
BASE_STAKE_USD=5
BASE_STAKE_PCT=4
# Skip trades below this AI confidence (0.60 = 60%)
MIN_CONFIDENCE=0.60
# At/above this confidence, size up (0.80 = 80%)
HIGH_CONF_THRESHOLD=0.80
# High-conviction entry as % of live USDT (5 = 5%).
# Never smaller than the standard entry. Never larger than MAX_STAKE_USD.
HIGH_CONF_STAKE_PCT=5
# Absolute cap per entry in USD
MAX_STAKE_USD=25
# Minimum edge vs market price (0.08 = 8 cents/share)
MIN_EDGE=0.08
# Only buy the LEADING side, and only if that side's ask is in this band.
# Never fade a cheap underdog (a 5¢ ticket is not an edge).
PRICE_BAND_MIN=0.05
PRICE_BAND_MAX=0.60
# Cheap-leader size-up (ETH 12.8¢ win). Still the strike leader only — no fade.
# Ask ≤ 30¢ and edge ≥ 20¢ → 12% of live USDT, LIMIT +1¢ to take the book.
CHEAP_EDGE=on
CHEAP_ASK_MAX=0.30
CHEAP_EDGE_MIN=0.20
CHEAP_EDGE_STAKE_PCT=12
CHEAP_TAKE_CENTS=0.01
# Circuit breaker: stop for the day after this many consecutive losses
MAX_LOSS_STREAK=3
# Extra guardrails
MAX_DAILY_TRADES=10
MAX_OPEN_POSITIONS=5
MIN_LIQUIDITY_USD=500
# Trading-day timezone for the circuit breaker reset
BOT_TIMEZONE=Asia/Jakarta
# Markets analyzed per scan and seconds between scans
MARKETS_PER_CYCLE=3
SCAN_INTERVAL_SEC=120
